# Copy this file to a new file named .env and put your own free key from https://console.groq.com
GROQ_API_KEY=your_key_here
# Optional: use a different Groq model for Alex (default is openai/gpt-oss-20b)
# ALEX_MODEL=openai/gpt-oss-120b
# Optional: faster replies (low | medium | high). Lower = faster.
# ALEX_REASONING=low

# Optional free backups. If Groq's daily limit runs out, Alex switches to these automatically.
# Cerebras: free key at https://cloud.cerebras.ai   OpenRouter: free key at https://openrouter.ai/keys
# CEREBRAS_API_KEY=your_key_here
# OPENROUTER_API_KEY=your_key_here
# Free model names change over time. If a backup stops working, change these:
# CEREBRAS_MODEL=gpt-oss-120b
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
